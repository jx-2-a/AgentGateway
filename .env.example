# ============ Agent Gateway 配置模板 ============
# 复制为 .env 并按需填写；.env 已被 .gitignore 排除，不会进入仓库。

# 监听地址与端口
HOST=0.0.0.0
PORT=8080

# 网关面板的访问令牌（登录用，务必改掉）
GATEWAY_TOKEN=change-me

# 对外可访问的基地址（gotif 推送的会话直达链接用它拼）
# 例如内网穿透/Tailscale 地址：http://100.64.0.0:8080
GATEWAY_PUBLIC_URL=http://127.0.0.1:8080

# ttyd 终端引擎可执行文件（Windows 上要带路径）
TTYD_PATH=ttyd

# 可选：ttyd 终端 basic auth（user:pass）
# TTYD_AUTH=

# ---- Gotify 推送服务（网关自动拉起+守护）----
# 手机通知依赖 Gotify server 在跑；网关启动时自动拉起，崩了自动重启。
GOTIFY_PATH=D:\OpenSourcePro\Gotify\gotify-windows-amd64.exe
# GOTIFY_URL=http://localhost   # gotif 库推送地址（默认本机:80）

# ---- 终端输出注意力提醒（agent 停下等你时推 gotif）----
# 有浏览器开着该会话的终端页时不推（说明你在看）；关掉终端页后，
# agent 持续输出一段时间又停在提示符（你 > / (y/N) / 请确认...）时高优推送。
ATTENTION_QUIET=8        # 输出停止 N 秒后才判定"在等输入"
ATTENTION_ACTIVITY=15    # 连续输出 N 秒以上才算"干过活"（过滤启动横幅噪音）
ATTENTION_GRACE=10       # 会话建立 N 秒内不推（启动噪音）
